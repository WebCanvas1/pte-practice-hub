# ---------------------------------------------------------------------------
# Public (browser-visible) configuration — safe to commit values here.
# These drive src/config/site.ts so the platform can be re-branded without
# code changes. Set them in Cloudflare Pages/Workers build settings too.
# ---------------------------------------------------------------------------
VITE_PLATFORM_NAME="ScorePath PTE"
VITE_PLATFORM_SHORT_NAME="ScorePath"
VITE_PLATFORM_TAGLINE="AI-powered PTE practice, from just $1"
VITE_PLATFORM_DESCRIPTION="Practice real PTE Academic tasks with instant automated scoring and AI feedback."
VITE_PLATFORM_LOGO_INITIALS="SP"
VITE_PLATFORM_LOGO_URL=""
VITE_SUPPORT_EMAIL="support@scorepath.example"
VITE_SUPPORT_PHONE="+61 2 8000 0000"
VITE_COMPANY_LEGAL_NAME="ScorePath Education Pty Ltd"
VITE_COMPANY_ADDRESS="Sydney, NSW, Australia"
VITE_COMPANY_ABN="00 000 000 000"
VITE_CURRENCY_CODE="AUD"
VITE_CURRENCY_SYMBOL="$"
VITE_PRICE_MODULE_TEST="1"
VITE_PRICE_FULL_MOCK="5"
VITE_SOCIAL_FACEBOOK=""
VITE_SOCIAL_INSTAGRAM=""
VITE_SOCIAL_YOUTUBE=""

# ---------------------------------------------------------------------------
# Server-only secrets (NEVER prefix with VITE_). Add these as Cloudflare
# secrets / GitHub Actions secrets when the backend is implemented.
# ---------------------------------------------------------------------------
# SESSION_SECRET=              # 32+ random chars for signed session cookies
# AUTH_JWT_SECRET=             # token signing for the Workers auth API
# AI_PROVIDER_API_KEY=         # AI scoring/feedback provider key
# EMAIL_API_KEY=               # transactional email (verify, password reset)
# SUPPORT_EMAIL=               # verified sender used for payment confirmations
# STRIPE_SECRET_KEY=           # Stripe test/live secret key; server only
# STRIPE_WEBHOOK_SECRET=       # signing secret for /api/public/stripe/webhook
# STRIPE_PUBLISHABLE_KEY=      # Stripe test/live publishable key
# APP_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Cloudflare bindings (declared in wrangler.toml, not as env vars):
#   D1        -> DB              relational data: users, tests, attempts, scores
#   R2        -> MEDIA           audio recordings, listening/speaking assets
#   KV        -> SETTINGS_KV     platform settings, cached config, rate limits
#   KV        -> SESSIONS_KV     session storage
# ---------------------------------------------------------------------------
